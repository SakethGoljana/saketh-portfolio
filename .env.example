# Master secret password for private CRM (/crm)
ADMIN_SECRET=your_master_admin_password_here

# Google Authenticator Base32 TOTP secret (Set in Authenticator / Authy app)
ADMIN_TOTP_SECRET=YOUR_BASE32_AUTHENTICATOR_SECRET

# Google Gemini API Key for Interactive Portfolio AI Chat Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Sheets Webhook URL & Secret (from Google Apps Script) for spreadsheet synchronization
# GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
# GOOGLE_SHEETS_SECRET=your_sheets_sync_secret_here
